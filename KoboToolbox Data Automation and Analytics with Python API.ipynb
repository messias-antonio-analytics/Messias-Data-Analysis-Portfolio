    processar_binaria(df, ['alimentos/crianca_risco_nutricao', 'crianca_risco_nutricao'], "Crianças em Risco Nutricional", cor=CORES_SETORES['Alimentação'])

    # ------------------------------------------------------------
    # H. ABRIGO
    # ------------------------------------------------------------
    print("\n🏠 H. ABRIGO")
